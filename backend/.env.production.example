# ─────────────────────────────────────────────────────────────────────────────
# EWMP backend — PRODUCTION settings template.
# Copy to `.env` on the server, fill every CHANGE_ME, and NEVER commit the result.
# Generate secrets:  python scripts/generate_secrets.py
# The app refuses to start in production if secrets are short/equal, DEBUG is
# on, or ALLOWED_ORIGINS has localhost / http:// / *  (see app/core/config.py).
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false                      # also turns SQL logging off

# ── Secrets (each at least 32 chars, all different) ──────────────────────────
SECRET_KEY=CHANGE_ME
AGENT_SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

# ── Public URLs ──────────────────────────────────────────────────────────────
FRONTEND_URL=https://hr.example.com
ALLOWED_ORIGINS=https://hr.example.com
# Number of reverse proxies in front of the API (nginx/Caddy = 1) so rate
# limits and lockouts see the real client IP.
TRUSTED_PROXY_COUNT=1

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ewmp:CHANGE_ME@localhost:5432/ewmp

# ── Redis / Celery (needed for auto-checkout, purge and health tasks) ────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── First admin (created by `python manage.py seed --superadmin`) ────────────
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=CHANGE_ME

# ── Email (verification mails, temporary passwords) ──────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
EMAILS_FROM_ADDRESS=noreply@example.com
EMAILS_FROM_NAME=EWMP
REQUIRE_EMAIL_VERIFICATION=true

# ── File storage: documents and screenshots ──────────────────────────────────
# local = server disk (back it up!).  s3 / r2 / minio = object storage.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage/uploads
# S3_BUCKET_NAME=ewmp-files
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_ENDPOINT_URL=              # for R2 / MinIO

# ── Device monitoring ────────────────────────────────────────────────────────
DEVICE_AUTO_SCREENSHOT_ENABLED=true
DEVICE_AUTO_SCREENSHOT_INTERVAL_SECONDS=60
DEVICE_SCREENSHOT_RETENTION_DAYS=7

# ── Security ─────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
LOGIN_LOCKOUT_ENABLED=true

# ── Features still unfinished: turn off so users don't see empty pages ───────
FEATURE_WORKFLOW_ENGINE=false
FEATURE_MARKETPLACE=false
FEATURE_BILLING=false
